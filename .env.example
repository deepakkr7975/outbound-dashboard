# AWS Credentials (DynamoDB)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Google OAuth Credentials (Gmail API)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/email-accounts/callback

# DynamoDB Tables
USERS_TABLE=users
EMAIL_ACCOUNTS_TABLE=email_accounts
LEADS_TABLE=leads
SCHEDULED_EMAILS_TABLE=scheduled_emails
EMAIL_LOGS_TABLE=email_logs
LEAD_LISTS_TABLE=lead_lists
SEQUENCES_TABLE=sequences
SEQUENCE_STEPS_TABLE=sequence_steps
CAMPAIGNS_TABLE=campaigns
EMAIL_TRANSACTIONS_TABLE=email_transactions
EMAIL_EVENTS_TABLE=email_events

# API auth — when set, all endpoints (except /gmail/callback and /unsubscribe)
# require this value in the X-API-Key header. Leave unset to disable auth (local dev).
API_KEY=

# Polling job for the direct /emails/* scheduling endpoints. On by default.
ENABLE_LEGACY_SCHEDULER=true

# Public base URL of this API — used to build unsubscribe links in outgoing emails.
APP_BASE_URL=http://127.0.0.1:8000
